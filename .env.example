# MCP Server Configuration
# Base URL for MCP server (without /mcp endpoint - that's added automatically)
# For local testing:
MCP_SERVER_URL=http://localhost:8080

# For ngrok/remote testing, use your ngrok URL (without /mcp):
# MCP_SERVER_URL=http://0.0.0.0:8080

# Google Cloud Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Optional: Google Cloud Project ID
GOOGLE_PROJECT_ID=your_project_id

# Gemini Model Configuration
# gemini-2.5-flash is no longer available to new API keys as of mid-2026.
# gemini-flash-latest currently resolves to gemini-3.5-flash, whose free tier
# is capped at 5 requests/minute/model — too low for this multi-agent pipeline.
# gemini-flash-lite-latest has a more generous free quota and is recommended.
GEMINI_MODEL=gemini-flash-lite-latest

# Host Agent Mode
# Options: basic, advanced, parallel
# - basic: Sequential execution (default)
# - advanced: Dynamic routing with conditional agent execution
# - parallel: Parallel execution with result synthesis
HOST_AGENT_MODE=basic
